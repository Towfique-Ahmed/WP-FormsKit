{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "formskit/form",
	"title": "Flint Forms Form",
	"category": "widgets",
	"icon": "feedback",
	"description": "Embed a Flint Forms form.",
	"keywords": [ "form", "contact", "formskit" ],
	"textdomain": "flint-forms",
	"supports": {
		"html": false,
		"align": [ "wide", "full" ]
	},
	"attributes": {
		"formId": {
			"type": "number",
			"default": 0
		}
	},
	"editorScript": "formskit-block-editor"
}
